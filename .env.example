# ---------------------------------------------------------------------------
# Easiest: copy exactly what Vercel uses
#   npx vercel link          (pick the "prdgm" project)
#   npx vercel env pull .env
# ---------------------------------------------------------------------------

# Database (set automatically on Vercel by the Neon integration). DATABASE_URL first, then POSTGRES_URL.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Public address of the site, used in email links and payment redirects.
APP_URL=https://prdgm.vercel.app

# Your email(s). These accounts become the owner (admin) on deploy and at login. Comma separated.
ADMIN_EMAILS=you@example.com

# Random secret for signing newsletter unsubscribe links (any long random string).
APP_SECRET=

# ----- Email (Resend: https://resend.com) -----
RESEND_API_KEY=
# Must use a domain you verified in Resend, e.g. "Paradigm <orders@yourdomain.com>".
# For testing only: "Paradigm <onboarding@resend.dev>" (can only send to your own Resend account email).
EMAIL_FROM=
# Where customer replies go (your inbox).
EMAIL_REPLY_TO=

# ----- Online payments (PayMongo: https://dashboard.paymongo.com) -----
# Use sk_test_... first, switch to sk_live_... after PayMongo activates your account.
PAYMONGO_SECRET_KEY=
# From the webhook you create for https://prdgm.vercel.app/api/payments/webhook (event: checkout_session.payment.paid)
PAYMONGO_WEBHOOK_SECRET=
# Optional: comma-separated methods enabled on your PayMongo account
PAYMONGO_METHODS=gcash,paymaya,card

# Secret Vercel Cron sends to /api/payments/cron (any long random string).
CRON_SECRET=

# Port for the local Express server
PORT=3000
